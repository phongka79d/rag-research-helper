# One OpenAI-compatible provider. It must support both /v1/responses and /v1/embeddings.
OPENAI_BASE_URL=https://api.shopaikey.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional graph-only model; leave blank to reuse OPENAI_MODEL.
# Example: gpt-4.1-nano
OPENAI_GRAPH_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

QDRANT_URL=http://localhost:6333

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

JINA_API_KEY=
JINA_RERANK_URL=https://api.jina.ai/v1/rerank
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
JINA_RPM=100
JINA_RERANK_MARGIN=0.08

QDRANT_SEARCH_LIMIT=25
QDRANT_MAX_CANDIDATE_PARENTS=5
